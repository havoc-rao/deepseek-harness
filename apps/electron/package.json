{
  "name": "@deepseek-ai/dsh-electron",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/main.mjs",
  "scripts": {
    "build": "tsc -b && tsdown",
    "dev": "pnpm run build && DSH_ELECTRON_DEV=1 electron .",
    "start": "electron .",
    "postinstall": "node scripts/ensure-electron-binary.mjs",
    "pack": "node scripts/pack-dist.mjs",
    "pack:dmg": "DSH_DMG=1 node scripts/pack-dist.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-host-terminal-web": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-terminal-protocol": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "tsdown": "latest",
    "typescript": "^6.0.3"
  }
}
